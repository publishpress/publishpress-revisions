msgstr "به‌طور پیش‌فرض"

#: admin/options.php:1859
#: admin/options.php:1882
msgid "Always"
msgstr "همیشه"

#: admin/options.php:1870
#: admin/options.php:1918
msgid "select recipients"
msgstr "گیرندگان را انتخاب کنید"

#: admin/options.php:1932
msgid ""
"To avoid notification failures, buffer emails for delayed sending once "
