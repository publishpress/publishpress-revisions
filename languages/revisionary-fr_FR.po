msgstr ""
"Lorsqu’une %s est publiée, mettre à jour la date de publication de la "
"publication à l’heure actuelle."

#: admin/options.php:1535
#: admin/options.php:1569
#, php-format
msgid "When a %s is published, update post modified date to current time."
msgstr ""
"Lorsqu’une %s est publiée, mettre à jour la date de modification de la "
"publication à l’heure actuelle."

#: admin/options.php:1538
msgid ""
"When a new revision is created by any user who is allowed to submit "
"revisions, automatically submit it."
msgstr ""
"Lorsqu’une nouvelle révision est créée par un utilisateur/utilisatrice "
"autorisé à envoyer des révisions, envoyer-la automatiquement."

#: admin/options.php:1541
msgid "Auto-submit revisions if the user can directly edit the main post."
msgstr ""
"Envoyer automatiquement les révisions si l’utilisteur/utilisatrice peut "
"modifier directement la publication principale."

#: admin/options.php:1544
msgid ""
"This allows immediate approval within the Compare screen. If disabled, a "
"Preview link is provided instead."
msgstr ""
"Ceci permet une approbation immédiate dans l’écran « Comparer ». Si "
"désactivé, un lien d’aperçu est fourni à la place."

