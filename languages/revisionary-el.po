msgstr "Αυτό μπορεί να βελτιώσει τη συμβατότητα με ορισμένα πρόσθετα."

#: admin/options.php:1703
#. translators: %s: PublishPress Capabilities plugin name or link.
#, php-format
msgid "If enabled, New Revisions screen access can be configured per-role using %s."
msgstr ""
