#: admin/options.php:1632
#, php-format
msgid "If enabled, Revision Submission access can be controlled per-role using %s"
msgstr ""
"Ha engedélyezve van, a verzió benyújtási hozzáférés szerepkörönként "
"vezérelhető a %s használatával."

#: admin/options.php:1644
